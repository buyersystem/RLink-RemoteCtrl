QPushButton, QToolButton, QLineEdit, QComboBox {
    outline: none;
}
QPushButton {
    min-height: 38px;
    border-radius: 10px;
    padding: 0 16px;
    font-weight: 600;
}
QLineEdit, QComboBox {
    min-height: 40px;
    border-radius: 10px;
}
QToolButton#profileUpdateButton {
    border-radius: 10px;
    padding: 6px;
}
